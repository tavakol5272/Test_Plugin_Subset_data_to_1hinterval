{
  "version": "1.2",
  "settings": [
    {
      "id": "interval_value",
      "name": "Interval length",
      "description": "Length of the time interval used for thinning. For each track, only the first location in each interval is kept. Must be a whole number of 1 or more. Default is 1.",
      "defaultValue": 1,
      "type": "INTEGER"
    },
    {
      "id": "interval_unit",
      "name": "Interval unit",
      "description": "Unit of the time interval used for thinning. Default is hour.",
      "defaultValue": "hour",
      "type": "DROPDOWN",
      "options": [
        { "value": "second", "displayText": "Second(s)" },
        { "value": "minute", "displayText": "Minute(s)" },
        { "value": "hour", "displayText": "Hour(s)" },
        { "value": "day", "displayText": "Day(s)" },
        { "value": "week", "displayText": "Week(s)" },
        { "value": "month", "displayText": "Month(s)" }
      ]
    }
  ],
  "dependencies": {
    "R": [
      {
        "name": "move2"
      }
    ]
  },
  "license": {
    "key": "MIT"
  },
  "language": "eng",
  "keywords": [
    "thinning",
    "subsampling",
    "time interval",
    "regular sampling",
    "data preparation",
    "move2"
  ],
  "people": [
    {
      "firstName": "Anne",
      "middleInitials": "K",
      "lastName": "Scharf",
      "email": "ascharf@ab.mpg.de",
      "roles": ["author", "creator"],
      "orcid": null,
      "affiliation": "Max-Planck-Institute of Animal Behavior",
      "affiliationRor": "https://ror.org/026stee22"
    }
  ],
  "references": [
    {
      "type": "Requires",
      "note": "Kranstauber, B., Safi, K., Scharf, A.K. 2024. move2: R package for processing movement data. Methods in Ecology and Evolution 15(9): 1561-1567.",
      "url": "https://doi.org/10.1111/2041-210X.14305"
    }
  ]
}
